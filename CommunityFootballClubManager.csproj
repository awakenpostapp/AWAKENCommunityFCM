<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>CommunityFootballClubManager</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name (package ID remains unchanged to preserve installed data,
		     OAuth callbacks and the existing Cloudflare tenant connection). -->
		<ApplicationTitle>AWAKEN Community FCM</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.awaken.communityfootballclubmanager</ApplicationId>

		<!-- Versions -->
		<!-- Release 3.3: keep the package/application ID stable so installed
		     data, OAuth callbacks and the Cloudflare connection remain intact. -->
		<ApplicationDisplayVersion>3.3</ApplicationDisplayVersion>
		<ApplicationVersion>116</ApplicationVersion>

		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormat>
		<AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
		<EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>

		<!-- Production signing uses the owner's keystore outside the repository.
		     Passwords and alias are read only from process environment variables:
		     COMMUNITY_FOOTBALL_KEYSTORE_PASSWORD,
		     COMMUNITY_FOOTBALL_KEY_PASSWORD and COMMUNITY_FOOTBALL_KEY_ALIAS. -->
		<AndroidKeyStore Condition="'$(Configuration)' == 'Release'">true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release' and '$(COMMUNITY_FOOTBALL_KEYSTORE_PATH)' != ''">$(COMMUNITY_FOOTBALL_KEYSTORE_PATH)</AndroidSigningKeyStore>
		<AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release' and '$(COMMUNITY_FOOTBALL_KEYSTORE_PATH)' == ''">F:\AWAKEN\CODING\KEYSTORE\AWPAppKEY.jks</AndroidSigningKeyStore>
		<AndroidSigningStorePass Condition="'$(Configuration)' == 'Release'">$(COMMUNITY_FOOTBALL_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
		<AndroidSigningKeyPass Condition="'$(Configuration)' == 'Release'">$(COMMUNITY_FOOTBALL_KEY_PASSWORD)</AndroidSigningKeyPass>
		<AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release'">$(COMMUNITY_FOOTBALL_KEY_ALIAS)</AndroidSigningKeyAlias>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon: supplied AWAKEN Enterprise Technology mark. -->
		<MauiIcon Include="Resources\AppIcon\awaken_enterprise_technology_logo.png" Color="#F8FAFC" />

		<!-- Splash Screen: supplied vertical Community FCM logo on the brand
		     background, without changing package identity or online configuration. -->
		<MauiSplashScreen Include="Resources\Splash\awaken_community_fcm_splash.png" Color="#F8FAFC" BaseSize="120,132" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<!-- The Cloudflare Worker lives beside the mobile project for one-repo
	     deployment. Exclude its TypeScript/npm tree from MAUI implicit globs. -->
	<ItemGroup>
		<!-- Historical snapshots are backup data, not source files. Keep them
		     out of the MAUI default compile glob to avoid duplicate types. -->
		<Compile Remove="backups\**\*" />
		<EmbeddedResource Remove="backups\**\*" />
		<MauiCss Remove="backups\**\*" />
		<MauiXaml Remove="backups\**\*" />
		<Content Remove="backups\**\*" />
		<None Remove="backups\**\*" />
		<Compile Remove="backend\**\*" />
		<EmbeddedResource Remove="backend\**\*" />
		<MauiCss Remove="backend\**\*" />
		<MauiXaml Remove="backend\**\*" />
		<Content Remove="backend\**\*" />
		<None Remove="backend\**\*" />
		<!-- Standalone diagnostic tools have their own project files and must
		     never be compiled into the Android application. -->
		<Compile Remove="tools\**\*" />
		<EmbeddedResource Remove="tools\**\*" />
		<Content Remove="tools\**\*" />
		<None Remove="tools\**\*" />
	</ItemGroup>

</Project>
