{
  "name": "community-football-club-manager-api",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.mjs --sourcemap",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test:roles": "node --test --experimental-strip-types tests/authorization.test.ts",
    "check": "npm run typegen && npm run typecheck && npm run build && wrangler deploy --dry-run",
    "smoke": "node scripts/smoke-production.mjs",
    "db:migrate:local": "wrangler d1 migrations apply community-football-club-manager --local",
    "db:migrate:remote": "wrangler d1 migrations apply community-football-club-manager --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "typescript": "^5.9.2",
    "wrangler": "4.120.0"
  }
}
