{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "community-football-club-manager-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_ENV": "staging",
    "APP_API_VERSION": "2.4.0",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_DAYS": "7",
    "MAX_UPLOAD_BYTES": "10485760",
    "ALLOWED_ORIGINS": "",
    "ALLOW_PUBLIC_FOUNDER_REGISTRATION": "false",
    "SUPABASE_URL": "https://REPLACE_WITH_SUPABASE_PROJECT.supabase.co",
    "DATA_BACKEND": "supabase",
    "OAUTH_CALLBACK_URL": "https://REPLACE_WITH_STAGING_WORKER/v1/auth/oauth/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-football-club-manager-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "community-football-club-manager-files-staging"
    }
  ]
}
